{
  "manifest_version": 3,
  "name": "Ocean Specials Facebook Poster",
  "version": "1.3.0",
  "description": "Guides Ocean Specials posts through saved Facebook groups one window at a time.",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "scripting",
    "system.display"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://ocean-specials.onrender.com/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ocean-specials.onrender.com/*",
        "http://localhost:*/*"
      ],
      "js": [
        "app_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*"
      ],
      "js": [
        "facebook_content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ocean FB Poster",
    "default_popup": "popup.html"
  }
}
